# API keys for PATCH /api/plans/:name, comma-separated, one per tester (generate: openssl rand -hex 16)
NUXT_API_KEYS=
# Database: a local SQLite file by default. In production use Turso (its Vercel Marketplace integration sets these).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Optional shared cache for /api/pricing
# NUXT_REDIS_URL=redis://localhost:6379
# Public origin for canonical/og URLs (detected automatically on Vercel)
# NUXT_SITE_URL=https://bisecthosting-takehome-quiz.vercel.app/
