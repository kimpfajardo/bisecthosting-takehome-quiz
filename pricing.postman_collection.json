{
  "info": {
    "name": "BisectHosting Pricing API",
    "description": "GET the starting price, PATCH a plan price with your API key, then GET again (or reload the site) to see the change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://bisecthosting-takehome-quiz.vercel.app" },
    { "key": "apiKey", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }] },
  "item": [
    {
      "name": "Get starting price",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/pricing" }
    },
    {
      "name": "Update plan price",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/plans/Budget",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"price_cents\": 349}", "options": { "raw": { "language": "json" } } }
      }
    }
  ]
}
